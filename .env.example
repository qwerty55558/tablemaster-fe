# ===========================================
# TableMaster Frontend - 환경 변수 템플릿
# ===========================================
# 복사 후 .env.local 생성: cp .env.example .env.local

# API 설정
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# WebSocket 설정
NEXT_PUBLIC_WS_URL=http://127.0.0.1:8080/ws

# NextAuth.js Secret (필수)
# 생성: openssl rand -base64 32
AUTH_SECRET=

# OAuth Providers (선택 - 사용 시 주석 해제)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=
