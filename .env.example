# ===========================================
# TableMaster Frontend - Environment Template
# ===========================================
# 이 파일을 복사하여 .env.local 생성 후 값 입력

# NextAuth.js Secret (필수)
# 생성: openssl rand -base64 32
AUTH_SECRET=

# OAuth Providers (선택)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
